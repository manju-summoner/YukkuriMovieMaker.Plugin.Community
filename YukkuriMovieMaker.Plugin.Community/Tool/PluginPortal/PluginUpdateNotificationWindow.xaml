<Window x:Class="YukkuriMovieMaker.Plugin.Community.Tool.PluginPortal.PluginUpdateNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:YukkuriMovieMaker.Plugin.Community.Tool.PluginPortal"
        Title="{x:Static local:Texts.PluginPortal}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="360"
        WindowStartupLocation="CenterOwner">
    <Window.Style>
        <Style TargetType="{x:Type Window}" BasedOn="{StaticResource {x:Type Window}}"/>
    </Window.Style>
    <StackPanel>
        <TextBlock Text="{x:Static local:Texts.PluginUpdatesAvailable}" FontWeight="Bold" Margin="12,12,12,8"/>
        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" Margin="12,0">
            <ItemsControl x:Name="updatesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding VersionText}" Margin="10,0,0,0"/>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Height="25" Margin="0,12,0,0">
            <Button Content="{x:Static local:Texts.OpenPluginPortal}" Padding="10,0" IsDefault="True" Click="OpenPluginPortal_Click"/>
            <Button Content="{x:Static local:Texts.Close}" Padding="10,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
