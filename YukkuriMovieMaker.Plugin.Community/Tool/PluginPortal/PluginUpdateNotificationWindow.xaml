<Window x:Class="YukkuriMovieMaker.Plugin.Community.Tool.PluginPortal.PluginUpdateNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:YukkuriMovieMaker.Plugin.Community.Tool.PluginPortal"
        Title="{x:Static local:Texts.PluginPortal}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="360"
        WindowStartupLocation="CenterOwner">
    <Window.Style>
        <Style TargetType="{x:Type Window}" BasedOn="{StaticResource {x:Type Window}}"/>
    </Window.Style>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{x:Static local:Texts.PluginUpdatesAvailable}" Margin="3"/>
        <ScrollViewer Grid.Row="1" MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="3,0,3,3">
            <ItemsControl x:Name="updatesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding VersionText}" Margin="10,0,0,0"/>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{x:Static local:Texts.OpenPluginPortal}" MinWidth="100" Padding="10,0" IsDefault="True" Click="OpenPluginPortal_Click"/>
            <Button Content="{x:Static local:Texts.Close}" Width="100" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
