<UserControl x:Class="YukkuriMovieMaker.Plugin.Community.Effect.Video.PuppetDeformation.PuppetPinListEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:YukkuriMovieMaker.Plugin.Community.Effect.Video.PuppetDeformation"
             xmlns:c="clr-namespace:YukkuriMovieMaker.Controls;assembly=YukkuriMovieMaker.Plugin"
             xmlns:icons="clr-namespace:YukkuriMovieMaker.Resources.Icons;assembly=YukkuriMovieMaker.Plugin"
             xmlns:pb="clr-namespace:YukkuriMovieMaker.Views.Behaviors;assembly=YukkuriMovieMaker.Plugin"
             xmlns:converter="clr-namespace:YukkuriMovieMaker.Views.Converters;assembly=YukkuriMovieMaker.Plugin"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="300">
    <i:Interaction.Behaviors>
        <pb:MessageBoxBehavior ViewModel="{Binding MessageBox}"/>
    </i:Interaction.Behaviors>
    <Grid>
        <Grid.Resources>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="26"/>
            <RowDefinition Height="{Binding Source={x:Static local:PuppetDeformationEditorSettings.Default}, Path=CanvasHeight, Mode=OneWay}"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="26"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--編集モード切替-->
        <UniformGrid Grid.Row="0" Rows="1" Columns="2" Margin="0,0,0,2">
            <RadioButton Style="{StaticResource {x:Type ToggleButton}}" Content="{x:Static local:Texts.PuppetDeformationModePin}" IsChecked="{Binding IsPinMode}"/>
            <RadioButton Style="{StaticResource {x:Type ToggleButton}}" Content="{x:Static local:Texts.PuppetDeformationModeBone}" IsChecked="{Binding IsBoneMode}"/>
        </UniformGrid>

        <!--ピン配置キャンバス-->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <local:PuppetPinCanvas x:Name="pinCanvas" Grid.Row="0" Grid.Column="0" ToolTip="{x:Static local:Texts.PuppetDeformationCanvasTooltip}"/>
            <!--表示範囲を移動するスクロールバー（スクロールの余地があるときだけ表示）-->
            <ScrollBar Grid.Row="0" Grid.Column="1" Orientation="Vertical"
                       Minimum="0"
                       Maximum="{Binding ScrollMaxY, ElementName=pinCanvas}"
                       ViewportSize="{Binding ScrollViewportH, ElementName=pinCanvas}"
                       LargeChange="{Binding ScrollViewportH, ElementName=pinCanvas}"
                       Value="{Binding ScrollOffsetY, ElementName=pinCanvas, Mode=TwoWay}"
                       Visibility="{Binding VScrollVisibility, ElementName=pinCanvas}"/>
            <ScrollBar Grid.Row="1" Grid.Column="0" Orientation="Horizontal"
                       Minimum="0"
                       Maximum="{Binding ScrollMaxX, ElementName=pinCanvas}"
                       ViewportSize="{Binding ScrollViewportW, ElementName=pinCanvas}"
                       LargeChange="{Binding ScrollViewportW, ElementName=pinCanvas}"
                       Value="{Binding ScrollOffsetX, ElementName=pinCanvas, Mode=TwoWay}"
                       Visibility="{Binding HScrollVisibility, ElementName=pinCanvas}"/>
            <!--キャンバス上のオーバーレイボタン（全体表示に戻す / 画像を更新）-->
            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="2">
                <Button Width="22" Height="22" Margin="0,0,2,0" Opacity="0.75"
                        Content="{DynamicResource {x:Static icons:IconKeys.FitToPage}}"
                        ToolTip="{x:Static local:Texts.PuppetDeformationCanvasResetViewTooltip}"
                        Click="ResetViewButton_Click"/>
                <Button Width="22" Height="22" Opacity="0.75"
                        Content="{DynamicResource {x:Static icons:IconKeys.Autorenew}}"
                        ToolTip="{x:Static local:Texts.PuppetDeformationCanvasRefreshTooltip}"
                        Command="{Binding RefreshImageCommand}"/>
            </StackPanel>
        </Grid>

        <!--キャンバスの高さ変更つまみ-->
        <Thumb Grid.Row="2" Cursor="SizeNS" Margin="0,1" DragDelta="CanvasResizeThumb_DragDelta">
            <Thumb.Template>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>

        <Grid Grid.Row="3">
            <Grid Visibility="{Binding IsPinMode, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition Width="26"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="{x:Static local:Texts.PuppetDeformationListAddPin}" Command="{Binding AddPinCommand}"/>
                <Button Grid.Column="1" Padding="6" Content="{DynamicResource {x:Static icons:IconKeys.Minus}}" ToolTip="{x:Static local:Texts.PuppetDeformationListRemovePin}" Command="{Binding RemovePinCommand}"/>
                <Button Grid.Column="2" Content="{DynamicResource {x:Static icons:IconKeys.Autorenew}}" ToolTip="{x:Static local:Texts.PuppetDeformationListResetMessage}" Command="{Binding ResetCommand}"/>
            </Grid>
            <Grid Visibility="{Binding IsBoneMode, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="26"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="{x:Static local:Texts.PuppetDeformationListAddBone}" Command="{Binding AddBoneCommand}"/>
                <Button Grid.Column="1" Padding="6" Content="{DynamicResource {x:Static icons:IconKeys.Minus}}" ToolTip="{x:Static local:Texts.PuppetDeformationListRemoveBone}" Command="{Binding RemoveBoneCommand}"/>
            </Grid>
        </Grid>
        <Grid Grid.Row="4" x:Name="editorArea" ClipToBounds="True" SizeChanged="EditorArea_SizeChanged">
            <c:PropertiesEditor x:Name="propertiesEditor" Margin="0,-22,0,0" Target="{Binding SelectedTarget}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="BeginEdit">
                        <i:InvokeCommandAction Command="{Binding OnBeginEditPointCommand}"/>
                    </i:EventTrigger>
                    <i:EventTrigger EventName="EndEdit">
                        <i:InvokeCommandAction Command="{Binding OnEndEditPointCommand}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </c:PropertiesEditor>
            <!--ジョイント/ピン未選択時は選択時と同じ高さを確保し、余白にメッセージを表示する-->
            <TextBlock Text="{Binding NoSelectionMessage}"
                       Visibility="{Binding HasNoSelection, Converter={StaticResource BoolToVisibility}}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Margin="12" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
        </Grid>
    </Grid>
</UserControl>
