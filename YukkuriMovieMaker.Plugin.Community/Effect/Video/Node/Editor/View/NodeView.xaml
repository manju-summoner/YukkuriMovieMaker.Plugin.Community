<UserControl x:Class="YukkuriMovieMaker.Plugin.Community.Effect.Video.Node.Editor.View.NodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModel="clr-namespace:YukkuriMovieMaker.Plugin.Community.Effect.Video.Node.Editor.ViewModel"
             xmlns:converters="clr-namespace:YukkuriMovieMaker.Plugin.Community.Effect.Video.Node.Editor.Converters"
             mc:Ignorable="d"
             MinWidth="200"
             d:DataContext="{d:DesignInstance viewModel:NodeViewModel}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="pack://application:,,,/YukkuriMovieMaker.Plugin.Community;component/Effect/Video/Node/Editor/View/Style/Style.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:PortControlTemplateSelector x:Key="PortControlTemplateSelector" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="8">
        <StackPanel>
            <!-- ヘッダー -->
            <TextBlock Text="{Binding DisplayName}"
                       Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                       FontWeight="Bold"
                       FontSize="12"
                       Margin="0,0,0,8" />

            <!-- 入力ポート -->
            <ItemsControl ItemsSource="{Binding InputPorts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <!-- ポート端子（左） -->
                            <Ellipse Width="10" Height="10"
                                     Fill="LightGreen"
                                     Margin="0,0,4,0" />

                            <!-- ラベル -->
                            <TextBlock Text="{Binding Label}"
                                       Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                                       FontSize="10"
                                       VerticalAlignment="Center" />

                            <!-- 値 -->
                            <ContentControl Content="{Binding}"
                                            ContentTemplateSelector="{StaticResource PortControlTemplateSelector}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="4,0,0,0">
                                <!-- コントロールがない場合のフォールバック -->
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Style.Triggers>
                                            <!-- コントロールがない、または接続されている場合は値を表示 -->
                                            <DataTrigger Binding="{Binding HasControl}" Value="False">
                                                <Setter Property="ContentTemplate">
                                                    <Setter.Value>
                                                        <DataTemplate />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>

                                            <!-- 接続されている場合はコントロールを非表示 -->
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 出力ポート -->
            <ItemsControl ItemsSource="{Binding OutputPorts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,2">
                            <!-- ラベル -->
                            <TextBlock Text="{Binding Label}"
                                       Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                                       FontSize="10"
                                       VerticalAlignment="Center" />

                            <!-- ポート端子（右） -->
                            <Ellipse Width="10" Height="10"
                                     Fill="LightBlue"
                                     Margin="4,0,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- サブグラフボタン -->
            <Button Content="Open SubGraph"
                    Command="{Binding OpenSubGraphCommand}"
                    HorizontalAlignment="Left"
                    Margin="0,4,0,0"
                    Visibility="{Binding HasSubGraph, Converter={StaticResource BoolToVisibilityConverter}}" />
        </StackPanel>
    </Border>
</UserControl>