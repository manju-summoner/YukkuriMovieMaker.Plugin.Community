<UserControl x:Class="YukkuriMovieMaker.Plugin.Community.Effect.Video.Node.Editor.View.NodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModel="clr-namespace:YukkuriMovieMaker.Plugin.Community.Effect.Video.Node.Editor.ViewModel"
             xmlns:converters="clr-namespace:YukkuriMovieMaker.Plugin.Community.Effect.Video.Node.Editor.Converters"
             xmlns:view="clr-namespace:YukkuriMovieMaker.Plugin.Community.Effect.Video.Node.Editor.View"
             mc:Ignorable="d"
             MinWidth="220"
             d:DataContext="{d:DesignInstance viewModel:NodeViewModel}"
             Background="Transparent"
             MouseLeftButtonDown="OnMouseLeftButtonDown"
             MouseMove="OnMouseMove"
             MouseLeftButtonUp="OnMouseLeftButtonUp">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="pack://application:,,,/YukkuriMovieMaker.Plugin.Community;component/Effect/Video/Node/Editor/View/Style/Style.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:PortControlTemplateSelector x:Key="PortControlTemplateSelector" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="5" MaxWidth="5" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition MinWidth="5" MaxWidth="5" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.RowSpan="6" Grid.Column="1"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush"
                            Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="BorderBrush"
                                    Value="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" />
                            <Setter Property="BorderThickness" Value="2" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
        <!-- ヘッダー -->
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DisplayName}"
                   Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                   FontWeight="Bold"
                   FontSize="12"
                   Margin="12,0,0,8" />

        <!-- 入力ポート -->
        <ItemsControl Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" ItemsSource="{Binding InputPorts}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <!-- ポート端子（左） -->
                        <view:PortView DataContext="{Binding}" />

                        <!-- ラベル -->
                        <TextBlock Text="{Binding Label}"
                                   Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0" />

                        <!-- 値 -->
                        <ContentControl Content="{Binding}"
                                        ContentTemplateSelector="{StaticResource PortControlTemplateSelector}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="8,0,0,0">
                            <!-- コントロールがない場合のフォールバック -->
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Style.Triggers>
                                        <!-- コントロールがない、または接続されている場合は値を表示 -->
                                        <DataTrigger Binding="{Binding HasControl}" Value="False">
                                            <Setter Property="ContentTemplate">
                                                <Setter.Value>
                                                    <DataTemplate />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>

                                        <!-- 接続されている場合はコントロールを非表示 -->
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Visibility" Value="Hidden" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 出力ポート -->
        <ItemsControl Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" ItemsSource="{Binding OutputPorts}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,2">
                        <!-- ラベル -->
                        <TextBlock Text="{Binding Label}"
                                   Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />

                        <!-- ポート端子（右） -->
                        <view:PortView DataContext="{Binding}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- サブグラフボタン -->
        <Button Grid.Row="4" Grid.Column="1" Content="Open SubGraph"
                Command="{Binding OpenSubGraphCommand}"
                HorizontalAlignment="Left"
                Margin="8,4,0, 0"
                Visibility="{Binding HasSubGraph, Converter={StaticResource BoolToVisibilityConverter}}" />
    </Grid>
</UserControl>