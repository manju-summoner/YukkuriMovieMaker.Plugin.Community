<controlbase:PortControlBase
    x:Class="YukkuriMovieMaker.Plugin.Community.Effect.Video.Node.Editor.Control.CustomEditor.CustomEditorPort"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controlbase="clr-namespace:YukkuriMovieMaker.Plugin.Community.Effect.Video.Node.Editor.Control"
    mc:Ignorable="d" Width="auto" MinWidth="100" MaxWidth="220" Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary
            Source="pack://application:,,,/YukkuriMovieMaker.Plugin.Community;component/Effect/Video/Node/Editor/View/Style/Style.xaml" />
    </UserControl.Resources>
    <!--
        中身は Create() で生成された任意の FrameworkElement（IPropertyEditorControl実装）を
        そのままホストするだけなので、コードビハインドから HostPresenter.Content を差し替える。
    -->
    <ContentPresenter x:Name="HostPresenter" VerticalAlignment="Center" />
</controlbase:PortControlBase>