<UserControl x:Class="YukkuriMovieMaker.Plugin.Community.Effect.Video.Node.Editor.Control.ColorPort"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:YukkuriMovieMaker.Plugin.Community.Effect.Video.Node.Editor.Control"
             mc:Ignorable="d"
             d:DesignHeight="Auto" d:DesignWidth="Auto">
    <UserControl.Resources>
        <local:ColorToHexConverter x:Key="ColorToHexConverter" />
    </UserControl.Resources>
    <Grid>
        <StackPanel Orientation="Horizontal" Margin="10">
            <Button x:Name="BtnColor" Width="20" Height="20" Click="btnColor_Click"
                    BorderThickness="1" Margin="0" Style="{x:Null}">
                <Button.Background>
                    <DrawingBrush Stretch="None" TileMode="Tile" Viewport="0,0,10,10" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Brush="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="0,0,10,10" />
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                                <GeometryDrawing Brush="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}">
                                    <GeometryDrawing.Geometry>
                                        <GeometryGroup>
                                            <RectangleGeometry Rect="0,0,5,5" />
                                            <RectangleGeometry Rect="5,5,5,5" />
                                        </GeometryGroup>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>

                                <GeometryDrawing>
                                    <GeometryDrawing.Brush>
                                        <SolidColorBrush
                                            Color="{Binding SelectedColor, RelativeSource={RelativeSource AncestorType=local:ColorPort}, Mode=TwoWay, ElementName=ColorPortControl}" />
                                    </GeometryDrawing.Brush>
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="0,0,10,10" />
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Button.Background>
            </Button>
            <TextBox Width="75" Height="25"
                     Text="{Binding SelectedColor, RelativeSource={RelativeSource AncestorType=local:ColorPort},
                     Converter={StaticResource ColorToHexConverter}, Mode=TwoWay, ElementName=ColorPortControl}"
                     VerticalContentAlignment="Center" FontFamily="Consolas" />
        </StackPanel>
        <Popup x:Name="Popup" AllowsTransparency="True" PlacementTarget="{Binding ElementName=BtnColor}"
               Placement="Bottom" StaysOpen="False" Closed="Popup_OnClosed">
            <Border BorderThickness="1" Padding="10"
                    Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- This is the focusable element not to make the popup close when clicking inside -->
                    <Grid Grid.ColumnSpan="3" Background="Transparent" IsHitTestVisible="True" Focusable="True"
                          PreviewMouseDown="UIElement_OnPreviewMouseDown" />

                    <local:ColorPicker Grid.Column="0"
                                       R="{Binding Red, RelativeSource={RelativeSource AncestorType=local:ColorPort}, Mode=TwoWay, ElementName=ColorPortControl}"
                                       G="{Binding Green, RelativeSource={RelativeSource AncestorType=local:ColorPort}, Mode=TwoWay, ElementName=ColorPortControl}"
                                       B="{Binding Blue, RelativeSource={RelativeSource AncestorType=local:ColorPort}, Mode=TwoWay, ElementName=ColorPortControl}"
                                       A="{Binding Alpha, RelativeSource={RelativeSource AncestorType=local:ColorPort}, Mode=TwoWay, ElementName=ColorPortControl}"
                                       H="{Binding Hue, RelativeSource={RelativeSource AncestorType=local:ColorPort}, Mode=TwoWay, ElementName=ColorPortControl}"
                                       S="{Binding Saturation, RelativeSource={RelativeSource AncestorType=local:ColorPort}, Mode=TwoWay, ElementName=ColorPortControl}"
                                       V="{Binding BValue, RelativeSource={RelativeSource AncestorType=local:ColorPort}, Mode=TwoWay, ElementName=ColorPortControl}"
                                       SelectedColor="{Binding SelectedColor, RelativeSource={RelativeSource AncestorType=local:ColorPort}, Mode=TwoWay, ElementName=ColorPortControl}" />

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="RGB" FontWeight="Bold" Margin="0,0,0,5" />
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="R:" Width="20" VerticalAlignment="Center" />
                            <TextBox
                                Text="{Binding Red, RelativeSource={RelativeSource AncestorType=local:ColorPort}, Mode=TwoWay, ElementName=ColorPortControl}"
                                Width="50" VerticalContentAlignment="Center" />
                            <Slider Minimum="0" Maximum="255" Width="150" Margin="5,0,0,0"
                                    Value="{Binding Red, RelativeSource={RelativeSource AncestorType=local:ColorPort}, Mode=TwoWay, ElementName=ColorPortControl}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="G:" Width="20" VerticalAlignment="Center" />
                            <TextBox
                                Text="{Binding Green, RelativeSource={RelativeSource AncestorType=local:ColorPort}, Mode=TwoWay, ElementName=ColorPortControl}"
                                Width="50" VerticalContentAlignment="Center" />
                            <Slider Minimum="0" Maximum="255" Width="150" Margin="5,0,0,0"
                                    Value="{Binding Green, RelativeSource={RelativeSource AncestorType=local:ColorPort}, Mode=TwoWay, ElementName=ColorPortControl}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="B:" Width="20" VerticalAlignment="Center" />
                            <TextBox
                                Text="{Binding Blue, RelativeSource={RelativeSource AncestorType=local:ColorPort}, Mode=TwoWay, ElementName=ColorPortControl}"
                                Width="50" VerticalContentAlignment="Center" />
                            <Slider Minimum="0" Maximum="255" Width="150" Margin="5,0,0,0"
                                    Value="{Binding Blue, RelativeSource={RelativeSource AncestorType=local:ColorPort}, Mode=TwoWay, ElementName=ColorPortControl}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="A:" Width="20" VerticalAlignment="Center" />
                            <TextBox
                                Text="{Binding Alpha, RelativeSource={RelativeSource AncestorType=local:ColorPort}, Mode=TwoWay, ElementName=ColorPortControl}"
                                Width="50" VerticalContentAlignment="Center" />
                            <Slider Minimum="0" Maximum="255" Width="150" Margin="5,0,0,0"
                                    Value="{Binding Alpha, RelativeSource={RelativeSource AncestorType=local:ColorPort}, Mode=TwoWay, ElementName=ColorPortControl}" />
                        </StackPanel>

                        <Separator Margin="0,10" />

                        <TextBlock Text="HSV" FontWeight="Bold" Margin="0,0,0,5" />
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="H:" Width="20" VerticalAlignment="Center" />
                            <TextBox
                                Text="{Binding Hue, RelativeSource={RelativeSource AncestorType=local:ColorPort}, Mode=TwoWay, ElementName=ColorPortControl, StringFormat={}{0:F1}}"
                                Width="50" VerticalContentAlignment="Center" />
                            <Slider Minimum="0" Maximum="359" Width="150" Margin="5,0,0,0"
                                    Value="{Binding Hue, RelativeSource={RelativeSource AncestorType=local:ColorPort}, Mode=TwoWay, ElementName=ColorPortControl}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="S:" Width="20" VerticalAlignment="Center" />
                            <TextBox
                                Text="{Binding Saturation, RelativeSource={RelativeSource AncestorType=local:ColorPort}, Mode=TwoWay, ElementName=ColorPortControl, StringFormat={}{0:P0}}"
                                Width="50" VerticalContentAlignment="Center" />
                            <Slider Minimum="0" Maximum="1" Width="150" Margin="5,0,0,0"
                                    Value="{Binding Saturation, RelativeSource={RelativeSource AncestorType=local:ColorPort}, Mode=TwoWay, ElementName=ColorPortControl}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="V:" Width="20" VerticalAlignment="Center" />
                            <TextBox
                                Text="{Binding BValue, RelativeSource={RelativeSource AncestorType=local:ColorPort}, Mode=TwoWay, ElementName=ColorPortControl, StringFormat={}{0:P0}}"
                                Width="50" VerticalContentAlignment="Center" />
                            <Slider Minimum="0" Maximum="1" Width="150" Margin="5,0,0,0"
                                    Value="{Binding BValue, RelativeSource={RelativeSource AncestorType=local:ColorPort}, Mode=TwoWay, ElementName=ColorPortControl}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>