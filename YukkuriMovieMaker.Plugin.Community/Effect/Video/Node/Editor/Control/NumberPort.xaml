<local:PortControlBase x:Class="YukkuriMovieMaker.Plugin.Community.Effect.Video.Node.Editor.Control.NumberPort"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:local="clr-namespace:YukkuriMovieMaker.Plugin.Community.Effect.Video.Node.Editor.Control"
                       mc:Ignorable="d" Width="auto" MinWidth="100" MaxWidth="220">
    <UserControl.Resources>
        <ResourceDictionary
            Source="pack://application:,,,/YukkuriMovieMaker.Plugin.Community;component/Effect/Video/Node/Editor/View/Style/Style.xaml" />
    </UserControl.Resources>
    <Grid>
        <StackPanel Orientation="Horizontal">
            <TextBox
                Text="{Binding Text, RelativeSource={RelativeSource AncestorType=local:NumberPort}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Focusable="{Binding IsFocusable, RelativeSource={RelativeSource AncestorType=local:NumberPort}, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                PreviewTextInput="PreviewTextInput" KeyDown="ValueSubmit"
                DataObject.Pasting="TextBoxPasting"
                VerticalAlignment="Center" VerticalContentAlignment="Center"
                PreviewMouseDown="Box_PreviewMouseDown"
                PreviewMouseLeftButtonDown="Box_PreviewMouseLeftButtonDown"
                PreviewMouseMove="Box_PreviewMouseMove"
                PreviewMouseLeftButtonUp="Box_PreviewMouseLeftButtonUp"
                LostFocus="Box_LostFocus" />
            <Label
                Content="{Binding Unit, RelativeSource={RelativeSource AncestorType=local:NumberPort}, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                VerticalAlignment="Center" VerticalContentAlignment="Center"
                Foreground="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                FontSize="10" />
        </StackPanel>
    </Grid>
</local:PortControlBase>