<controlbase:PortControlBase
    x:Class="YukkuriMovieMaker.Plugin.Community.Effect.Video.Node.Editor.Control.Bezier.BezierPort"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:YukkuriMovieMaker.Plugin.Community.Effect.Video.Node.Editor.Control.Bezier"
    xmlns:view="clr-namespace:YukkuriMovieMaker.Plugin.Community.Effect.Video.Node.Editor.Control.Bezier.View"
    xmlns:controlbase="clr-namespace:YukkuriMovieMaker.Plugin.Community.Effect.Video.Node.Editor.Control"
    mc:Ignorable="d"
    d:DesignHeight="270" d:DesignWidth="220"
    d:DataContext="{d:DesignInstance local:BezierPort}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="pack://application:,,,/YukkuriMovieMaker.Plugin.Community;component/Effect/Video/Node/Editor/View/Style/Style.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <CollectionViewSource x:Key="GroupedPresets"
                                  Source="{Binding Presets, RelativeSource={RelativeSource AncestorType=local:BezierPort}}">
                <CollectionViewSource.GroupDescriptions>
                    <PropertyGroupDescription PropertyName="Category" />
                </CollectionViewSource.GroupDescriptions>
            </CollectionViewSource>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox Grid.Row="0"
                 Text="{Binding TextBoxBuffer, RelativeSource={RelativeSource AncestorType=local:BezierPort}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 VerticalAlignment="Center" VerticalContentAlignment="Center"
                 HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                 Width="200"
                 GotFocus="OnTextBoxGotFocus"
                 LostFocus="OnTextBoxLostFocus"
                 KeyDown="OnTextBoxKeyDown" />
        <view:BezierEditor x:Name="Editor"
                           Grid.Row="1"
                           Width="200"
                           Height="200"
                           ViewModel="{Binding ViewModel, RelativeSource={RelativeSource AncestorType=local:BezierPort}}"
                           ClipToBounds="True"
                           ControlBrush="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                           GridBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                           AccentBrush="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" />
        <ComboBox Grid.Row="2"
                  ItemsSource="{Binding Source={StaticResource GroupedPresets}}"
                  SelectedItem="{Binding SelectedPresetItem, RelativeSource={RelativeSource AncestorType=local:BezierPort}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue={x:Null}}"
                  SelectionChanged="OnPresetComboBoxSelectionChanged">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock x:Name="DisplayArea" Text="{Binding Name}" />

                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}}"
                                     Value="{x:Null}">
                            <Setter TargetName="DisplayArea" Property="Text">
                                <Setter.Value>
                                    <MultiBinding StringFormat="{}{0} [{1}]">
                                        <Binding Path="Category" />
                                        <Binding Path="Name" />
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ComboBox.ItemTemplate>
            <ComboBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="4,2" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ComboBox.GroupStyle>
        </ComboBox>
    </Grid>
</controlbase:PortControlBase>