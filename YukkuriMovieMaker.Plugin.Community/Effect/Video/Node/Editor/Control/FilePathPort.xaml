<local:PortControlBase x:Class="YukkuriMovieMaker.Plugin.Community.Effect.Video.Node.Editor.Control.FilePathPort"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:local="clr-namespace:YukkuriMovieMaker.Plugin.Community.Effect.Video.Node.Editor.Control"
                       mc:Ignorable="d"
                       d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
        <ResourceDictionary
            Source="pack://application:,,,/YukkuriMovieMaker.Plugin.Community;component/Effect/Video/Node/Editor/View/Style/Style.xaml" />
    </UserControl.Resources>

    <Grid>
        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
            <Button Content="Select"
                    Command="{Binding OpenFileCommand, RelativeSource={RelativeSource AncestorType=local:FilePathPort}}"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center" />
            <TextBlock Text="{Binding PathFileText, RelativeSource={RelativeSource AncestorType=local:FilePathPort}}"
                       ToolTip="{Binding Value, RelativeSource={RelativeSource AncestorType=local:FilePathPort}}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap"
                       HorizontalAlignment="Left"
                       FontSize="10" />
        </StackPanel>
    </Grid>
</local:PortControlBase>