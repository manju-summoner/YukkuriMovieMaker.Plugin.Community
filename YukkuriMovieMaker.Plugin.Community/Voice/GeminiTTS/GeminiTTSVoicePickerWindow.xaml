<Window x:Class="YukkuriMovieMaker.Plugin.Community.Voice.GeminiTTS.GeminiTTSVoicePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:YukkuriMovieMaker.Plugin.Community.Voice.GeminiTTS"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:GeminiTTSVoicePickerViewModel}"
        Title="{x:Static local:Texts.AddVoicesWindowTitle}"
        Width="1000" Height="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource {x:Type Window}}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" IsEnabled="{Binding IsLoaded}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="{x:Static local:Texts.Language}" VerticalContentAlignment="Center"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding Languages}" SelectedValuePath="Value" DisplayMemberPath="Name" SelectedValue="{Binding SelectedLanguage}" VerticalContentAlignment="Center"/>
            <Label Grid.Column="2" Content="{x:Static local:Texts.Gender}" VerticalContentAlignment="Center"/>
            <ComboBox Grid.Column="3" ItemsSource="{Binding Genders}" SelectedValuePath="Value" DisplayMemberPath="Name" SelectedValue="{Binding SelectedGender}" VerticalContentAlignment="Center"/>
            <Label Grid.Column="4" Content="{x:Static local:Texts.Search}" VerticalContentAlignment="Center"/>
            <TextBox Grid.Column="5" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}" VerticalContentAlignment="Center"/>
        </Grid>

        <DataGrid Grid.Row="1" ItemsSource="{Binding ItemsView}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                  SelectionMode="Single" HeadersVisibility="Column"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" EnableRowVirtualization="True">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{x:Static local:Texts.Kind}" Binding="{Binding Info.KindText, Mode=OneWay}" IsReadOnly="True"/>
                <DataGridTextColumn Header="{x:Static local:Texts.VoiceName}" Binding="{Binding Info.DisplayName, Mode=OneWay}" IsReadOnly="True"/>
                <DataGridTextColumn Header="{x:Static local:Texts.Language}" Binding="{Binding Info.LanguageCode, Mode=OneWay}" IsReadOnly="True"/>
                <DataGridTextColumn Header="{x:Static local:Texts.Accent}" Binding="{Binding Info.Accent, Mode=OneWay}" IsReadOnly="True"/>
                <DataGridTextColumn Header="{x:Static local:Texts.Gender}" Binding="{Binding Info.GenderText, Mode=OneWay}" IsReadOnly="True"/>
                <DataGridTextColumn Header="{x:Static local:Texts.Pitch}" Binding="{Binding Info.Pitch, Mode=OneWay}" IsReadOnly="True"/>
                <DataGridTextColumn Header="{x:Static local:Texts.Persona}" Binding="{Binding Info.Persona, Mode=OneWay}" IsReadOnly="True" Width="200"/>
                <DataGridTextColumn Header="{x:Static local:Texts.Description}" Binding="{Binding Info.Description, Mode=OneWay}" IsReadOnly="True" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="1" Text="{x:Static local:Texts.LoadingVoices}" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <TextBlock Grid.Row="2" Text="{Binding ErrorText}" Foreground="Red" Margin="6" TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ErrorText}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Height="26">
            <Button Content="{x:Static local:Texts.Add}" Width="100" IsEnabled="{Binding IsLoaded}" Click="AddButton_Click"/>
            <Button Content="{x:Static local:Texts.Cancel}" Width="100" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
